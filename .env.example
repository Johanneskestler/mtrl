# Environment Configuration Example for MTRL Cluster Deployment
# Copy to .env and customize for your setup

# ============================================================================
# CLUSTER CONFIGURATION
# ============================================================================

# TU Wien DataLAB Cluster credentials
CLUSTER_HOST=datalab
CLUSTER_USER=e11704784
CLUSTER_PROJECT_DIR=/home/${CLUSTER_USER}/mtrl_project
CLUSTER_WORK_DIR=/share/${CLUSTER_USER}/mtrl_work

# ============================================================================
# CONTAINER CONFIGURATION
# ============================================================================

# Docker image settings
DOCKER_IMAGE_NAME=mtrl
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=  # Leave empty for local, or set to registry URL

# Singularity image path (local)
SINGULARITY_IMAGE=mtrl.sif

# ============================================================================
# W&B CONFIGURATION
# ============================================================================

# W&B Project settings
WANDB_PROJECT=Robot_learning_2025
WANDB_ENTITY=Robot_learning_2025
WANDB_MODE=online  # online, offline, or disabled

# W&B API Key (set via: export WANDB_API_KEY="..." or bash setup_wandb.sh)
# WANDB_API_KEY=  # NEVER commit this! Use setup script instead

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================

# Experiment settings
EXPERIMENT_NAME=mt10_full
SEED=1
TOTAL_STEPS=2000000  # 2M steps for full training

# Environment
ENV_ID=MT10  # MT10 or MT50
NUM_TASKS=10
NUM_PARALLEL_ENVS=32

# Hyperparameters
BATCH_SIZE=512
BUFFER_SIZE=2000000
LEARNING_RATE=0.0003
GAMMA=0.99

# ============================================================================
# GPU/SLURM CONFIGURATION
# ============================================================================

# GPU allocation
GPUS_PER_NODE=1
CPUS_PER_GPU=8
MEM_PER_NODE=48G  # 32G for test, 48G for full training

# SLURM job configuration
SLURM_PARTITION=GPU-a40
SLURM_TIME_LIMIT=24:00:00  # 1h for test, 24h for full
SLURM_JOB_NAME=mtrl_training

# ============================================================================
# LOGGING AND MONITORING
# ============================================================================

# Logging frequency
LOG_FREQUENCY=100
CHECKPOINT_FREQUENCY=100000

# System monitoring
TRACK_GPU_MEMORY=true
TRACK_GPU_UTILIZATION=true
TRACK_CPU_UTILIZATION=true

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================

# JAX configuration
JAX_DEVICE_COUNT=1
JAX_PLATFORMS=gpu
TF_CPP_MIN_LOG_LEVEL=2

# MuJoCo rendering (headless)
MUJOCO_GL=osmesa

# Python settings
PYTHONUNBUFFERED=1
OMP_NUM_THREADS=8

# ============================================================================
# LOCAL PATHS (for development/testing)
# ============================================================================

# Local project paths
LOCAL_MODELS_DIR=./models
LOCAL_LOGS_DIR=./logs
LOCAL_WANDB_CACHE=./wandb_cache
LOCAL_CHECKPOINT_DIR=./checkpoints

# ============================================================================
# DEPLOYMENT FLAGS
# ============================================================================

# Enable/disable features
ENABLE_WANDB_TRACKING=true
ENABLE_CHECKPOINTING=true
ENABLE_RESUME=false
ENABLE_SYSTEM_MONITORING=true

# Build options
DOCKER_REBUILD=false  # Force rebuild docker image
SIF_REBUILD=false  # Force rebuild singularity image
UPLOAD_CODE=true  # Upload code to cluster

# ============================================================================
# NOTES
# ============================================================================

# DO NOT commit API keys or sensitive information!
# This file should be kept in .gitignore
# For cluster: source this file before running scripts
# For local: use for development/testing configuration
